# OAuth App client id with "Enable Device Flow" ticked. Leave empty to use personal access tokens only.
GITHUB_CLIENT_ID=
# Use "read:user repo" to allow private repositories.
GITHUB_SCOPES=read:user public_repo
# Optional: encrypts the stored token. Without it a random key is kept in .data/secret.key.
APP_SECRET=

PORT=4173
SYNC_INTERVAL_MINUTES=60
MAX_COMMITS_PER_RUN=60
MAX_CHECKS_PER_RUN=6
RECHECK_DELAY_SECONDS=90
